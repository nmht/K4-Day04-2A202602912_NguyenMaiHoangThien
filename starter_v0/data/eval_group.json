      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "email",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "single_service",
        "what_it_tests": "Route to check_service_status for email"
      }
    },
    {
